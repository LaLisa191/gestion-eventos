
# Base de datos DE PRUEBAS. El nombre de la base debe terminar en "-test"
# (jest.setup.js se niega a limpiar cualquier otra para no borrar datos reales).
# Ejemplos:
#   Local:  mongodb://127.0.0.1:27017/gestion-eventos-test
#   Atlas:  mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/gestion-eventos-test
MONGODB_URI=mongodb://127.0.0.1:27017/gestion-eventos-test

# Clave para firmar los tokens JWT durante las pruebas (cualquier texto largo)
JWT_SECRET=cambia-esta-clave-de-pruebas

PORT=3000
APP_URL=http://localhost:3000

# El envio de correo se simula en las pruebas (jest.setup.js), pero las variables deben existir
EMAIL_USER=correo-de-prueba@example.com
EMAIL_PASS=no-se-usa-en-pruebas
